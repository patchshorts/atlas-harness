{
  "name": "@atlasai/atsh-accounting",
  "description": "Token accounting ledger + credit grants + per-account budget caps (ctx.accounting): debits ledger rows from intercepted llm/stream usage, vetoes tool calls at the tools/execute boundary when a budget cap is exhausted",
  "version": "0.1.0-rc.5",
  "private": true,
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/accounting/accounting"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@deepseek-ai/schemastery": "workspace:^"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:^",
    "@atlasai/atsh-invariants": "workspace:^",
    "@atlasai/atsh-llm": "workspace:^",
    "@atlasai/atsh-tools": "workspace:^"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:^",
    "@atlasai/atsh-llm": "workspace:^",
    "@atlasai/atsh-system-prompt": "workspace:^",
    "@atlasai/atsh-tools": "workspace:^"
  }
}

    "@atlasai/atsh-system-prompt": "workspace:^"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "workspace:^"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:^",
    "@atlasai/atsh-agent": "workspace:^",
    "@atlasai/atsh-invariants": "workspace:^",
    "@atlasai/atsh-llm": "workspace:^",
    "@atlasai/atsh-memory": "workspace:^",
    "@atlasai/atsh-prompt-corpus": "workspace:^",
    "@atlasai/atsh-session": "workspace:^",
    "@atlasai/atsh-system-prompt": "workspace:^"
  }

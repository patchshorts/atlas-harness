{
  "name": "@atlasai/atsh-goal-round-driver",
  "description": "Race-fenced same-session goal-round driver",
  "version": "0.1.0-rc.5",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/goal/goal-round-driver"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@atlasai/atsh-agent": "workspace:^",
    "@atlasai/atsh-goal": "workspace:^",
    "@atlasai/atsh-invariants": "workspace:^",
    "@atlasai/atsh-llm": "workspace:^",
    "@atlasai/atsh-session": "workspace:^",
    "@deepseek-ai/cordis": "workspace:^"
  },
  "devDependencies": {
    "@atlasai/atsh-agent": "workspace:^",
    "@atlasai/atsh-agent-loop": "workspace:^",
    "@atlasai/atsh-agent-loop-testkit": "workspace:^",
    "@atlasai/atsh-goal": "workspace:^",
    "@atlasai/atsh-invariants": "workspace:^",
    "@atlasai/atsh-llm": "workspace:^",
    "@atlasai/atsh-session": "workspace:^",
    "@atlasai/atsh-system-prompt": "workspace:^",
    "@atlasai/atsh-tools": "workspace:^",
    "@deepseek-ai/cordis": "workspace:^"
  }
}
